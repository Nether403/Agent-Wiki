{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://design-wiki.dev/schemas/registry-item.json",
  "title": "DesignAgentWikiRegistryItem",
  "description": "Component registry item schema for Machine-First Design Agent Wiki, fully compatible with shadcn CLI while embedding agentic metadata, taste dials, and a11y contracts.",
  "type": "object",
  "required": [
    "name",
    "type",
    "title",
    "description",
    "category",
    "tags",
    "dials",
    "a11y",
    "files"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique slug identifier for the component (e.g., 'canvas-fluid-wave', 'floating-dock')."
    },
    "type": {
      "type": "string",
      "enum": [
        "registry:ui",
        "registry:component",
        "registry:block",
        "registry:hook",
        "registry:lib",
        "registry:page"
      ],
      "description": "The shadcn component type definition."
    },
    "title": {
      "type": "string",
      "description": "Human-readable title of the component."
    },
    "description": {
      "type": "string",
      "description": "Concise explanation of functionality and usage."
    },
    "category": {
      "type": "string",
      "enum": [
        "ui:primitive",
        "ui:motion",
        "ui:creative",
        "ui:editorial",
        "ui:block",
        "ui:media",
        "ui:utility"
      ],
      "description": "Primary architectural taxonomy category."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Technical and aesthetic tags (e.g., 'tailwind-v4', 'motion/react', 'webgl', 'bento-grid')."
    },
    "dials": {
      "type": "object",
      "required": ["design_variance", "motion_intensity", "visual_density"],
      "properties": {
        "design_variance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "1: Rigid/centered · 10: Asymmetric/Avant-garde editorial."
        },
        "motion_intensity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "1: Static/subtle hover · 10: Orchestrated canvas/WebGL/spring transitions."
        },
        "visual_density": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "1: Airy whitespace · 10: Dense SaaS/data-heavy grid."
        }
      }
    },
    "a11y": {
      "type": "object",
      "required": ["keyboard_navigable", "wai_aria_compliant", "fallback_provided"],
      "properties": {
        "keyboard_navigable": {
          "type": "boolean",
          "description": "Whether interactive controls are fully operable via keyboard."
        },
        "wai_aria_compliant": {
          "type": "boolean",
          "description": "Whether ARIA roles and accessibility labels are implemented."
        },
        "wai_aria_role": {
          "type": "string",
          "description": "Primary WAI-ARIA role if applicable (e.g., 'dialog', 'navigation', 'tablist')."
        },
        "screen_reader_ready": {
          "type": "boolean",
          "description": "Whether SVG icons, canvas, and live regions provide screen-reader announcements."
        },
        "fallback_provided": {
          "type": "boolean",
          "description": "Whether WebGL/Canvas/heavy motion components provide static or CSS fallbacks."
        },
        "reduced_motion_supported": {
          "type": "boolean",
          "description": "Whether motion degrades gracefully when prefers-reduced-motion is active."
        }
      }
    },
    "license_origin": {
      "type": "object",
      "required": ["source_repository", "license_type", "author"],
      "properties": {
        "source_repository": {
          "type": "string",
          "description": "Upstream source repository URL or library name."
        },
        "license_type": {
          "type": "string",
          "description": "SPDX identifier or license name (e.g., 'MIT', 'Apache-2.0', 'Commons-Clause')."
        },
        "author": {
          "type": "string",
          "description": "Original author or organization."
        },
        "attribution_required": {
          "type": "boolean",
          "default": true
        },
        "redistribution_mode": {
          "type": "string",
          "enum": ["full_source", "proxy_recipe", "submodule"],
          "description": "'full_source' for permissive licenses, 'proxy_recipe' for restricted licenses."
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Runtime npm dependencies required by the component (e.g., 'motion/react', 'lucide-react')."
    },
    "devDependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Development npm dependencies required by the component."
    },
    "registryDependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Names or URLs of peer registry items this component depends on (e.g., 'button', 'dialog')."
    },
    "tailwind": {
      "type": "object",
      "properties": {
        "config": {
          "type": "object",
          "description": "Tailwind configuration tokens or theme variables."
        },
        "theme": {
          "type": "object",
          "description": "Tailwind v4 @theme variable definitions."
        }
      }
    },
    "cssVars": {
      "type": "object",
      "properties": {
        "light": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "dark": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "type"],
        "properties": {
          "path": {
            "type": "string",
            "description": "Relative file path within the project (e.g., 'registry/ui/fluid-wave.tsx')."
          },
          "content": {
            "type": "string",
            "description": "Full escaped string content of the component file for direct CLI download."
          },
          "type": {
            "type": "string",
            "enum": [
              "registry:ui",
              "registry:component",
              "registry:block",
              "registry:hook",
              "registry:lib",
              "registry:page",
              "registry:file"
            ]
          },
          "target": {
            "type": "string",
            "description": "Optional destination path in the consumer workspace."
          }
        }
      }
    }
  }
}
